        <entry key="script" type="xstring" value="import knime.scripting.io as knio%%00010%%00010# This example script simply outputs the node's input table.%%00010# Copy input to output%%00010import operator%%00010import pandas as pd%%00010%%00010data = knio.input_tables[0].to_pandas()%%00010data[knio.flow_variables['percentile_filter_column']] = pd.to_numeric(data[knio.flow_variables['percentile_filter_column']], errors=&quot;coerce&quot;).astype(&quot;Float64&quot;)%%00010%%00010# dictionary of possibly used operators and associated methods%%00010operators = {&quot;&gt;&quot;: operator.gt,%%00010       &quot;&gt;=&quot;: operator.ge,%%00010       &quot;&lt;=&quot;: operator.le,%%00010       &quot;&lt;&quot;: operator.lt}%%00010%%00010# gets associated method for the dataframe filtration based on the percentile value%%00010operator_func = operators[knio.flow_variables['operator']]%%00010%%00010# adds columns with rank and percentile values based on the selected filtering column%%00010data[knio.flow_variables['percentile_filter_column']+'_rank'] = data[knio.flow_variables['percentile_filter_column']].rank(method=knio.flow_variables['ranking_method'], na_option='keep', ascending=True, pct=False)%%00010data[knio.flow_variables['percentile_filter_column']+'_percentile'] = data[knio.flow_variables['percentile_filter_column']].rank(method=knio.flow_variables['ranking_method'], na_option='keep', ascending=True, pct=True)%%00010%%00010# creates a pandas series with boolean info whether the percentile values passes (=true) the specified conditions (threshold and operator) or not (=false)%%00010true_matrix = operator_func(data[knio.flow_variables['percentile_filter_column']+'_percentile'], knio.flow_variables['percentile_threshold'])%%00010%%00010# filters the input dataframe with additional columns using the true_matrix%%00010knio.output_tables[0] = knio.Table.from_pandas(data[true_matrix])%%00010knio.output_tables[1] = knio.Table.from_pandas(data[~true_matrix])%%00010"/>
