        <entry key="script" type="xstring" value="%%00010generateDataset &lt;- function(n = 10000, samples.per.group = 3,%%00010%%00009DE.proportion = 0.05, logFC = 0) {%%00010%%00010%%00009n.samples &lt;- 2 * samples.per.group%%00010%%00010%%00009baseline &lt;- rnorm(n, mean = 25, sd = 2)%%00010%%00009protein.sd &lt;- runif(n, min =  0.2, max = 0.8)%%00010     DE.idx &lt;- sample(seq_len(n), round(n*DE.proportion))%%00010     group &lt;- factor(rep(c(&quot;A&quot;, &quot;B&quot;), each = samples.per.group))%%00010%%00009%%00010%%00009data &lt;- matrix(nrow = n, ncol = n.samples)%%00010%%00010%%00009for(i in seq_len(n)) {%%00010        muA &lt;- baseline[i]%%00010        muB &lt;- baseline[i]%%00010        if(i %in% DE.idx) muB &lt;- muB + logFC%%00010%%00010        data[i, group == &quot;A&quot;] &lt;- rnorm(samples.per.group, muA, protein.sd[i])%%00010%%00010        data[i, group == &quot;B&quot;] &lt;- rnorm(samples.per.group, muB, protein.sd[i])%%00010    }%%00010%%00010%%00009# rename dimensions%%00010%%00009colnames(data) &lt;- c(paste0(&quot;A&quot;, 1:samples.per.group), paste0(&quot;B&quot;, 1:samples.per.group))%%00010%%00009rownames(data) &lt;- paste0(&quot;Protein_&quot;, seq_len(n))%%00010%%00010%%00009return(data)%%00010}"/>
